FROM node:20-alpine

# 必要なパッケージをインストール
RUN apk add --no-cache python3 make g++

# 作業ディレクトリを設定
WORKDIR /app

# package.jsonとpackage-lock.jsonをコピー
COPY package*.json ./

# node_modulesをクリーンインストール（package.jsonのwrangler ^4.42.0を使用）
RUN npm ci || npm install

# ソースコードをコピー
COPY . .

# ポート8787を公開
EXPOSE 8787

# 開発サーバーを起動（npx wranglerを使用）
CMD ["npx", "wrangler", "dev", "--port", "8787", "--host", "0.0.0.0"]
